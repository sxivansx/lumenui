{
  "name": "lumenui-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run build --filter=lumenui && turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "biome format --write .",
    "check": "turbo run typecheck lint test build",
    "changeset": "changeset",
    "version": "changeset version && bun update",
    "release": "turbo run build --filter=lumenui && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@changesets/cli": "^2.27.0",
    "turbo": "^2.9.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20",
    "bun": ">=1.3"
  }
}
