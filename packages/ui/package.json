{
  "name": "lumenui",
  "version": "0.1.0",
  "description": "Accessible, themeable React UI components built on Radix UI and Tailwind CSS v4.",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "react",
    "nextjs",
    "ui",
    "components",
    "component-library",
    "tailwindcss",
    "radix-ui",
    "design-system"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./theme.css": "./dist/theme.css",
    "./lib/utils": {
      "types": "./dist/lib/utils.d.ts",
      "import": "./dist/lib/utils.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown && bun run build:css",
    "build:css": "tailwindcss -i ./src/styles.css -o ./dist/styles.css --minify && cp ./src/styles.css ./dist/theme.css",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check ."
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "radix-ui": "^1.4.3",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "jest-axe": "^10.0.0",
    "jsdom": "^29.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.0",
    "tsdown": "^0.22.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  }
}
